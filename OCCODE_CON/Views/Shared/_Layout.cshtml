<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OCCODE_CON</title>

    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png">
    <meta name="theme-color" content="#E32626"> <!-- Rojo EVA-02 -->

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OCCODE_CON.styles.css" asp-append-version="true" />

    <style>
        :root {
            /* Paleta de colores EVA-02 */
            --color-primary-dark: #231F2A; /* Azul oscuro / Negro grisáceo */
            --color-primary-main: #E32626; /* Rojo sangre */
            --color-secondary-main: #E88031; /* Naranja intenso */
            --color-secondary-light: #F69D55; /* Naranja claro / Durazno */
            --color-background-light: #F8E7E7; /* Blanco rosáceo */
        }

        body {
            background-color: var(--color-background-light);
            color: var(--color-primary-dark);
        }

        /* Navbar principal */
        .custom-navbar {
            background-color: var(--color-primary-main) !important;
            border-bottom: 3px solid var(--color-secondary-main);
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }

        .navbar-brand {
            color: var(--color-background-light) !important;
            font-weight: 800;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
        }

        .navbar-toggler {
            border: 2px solid var(--color-secondary-main);
            color: var(--color-secondary-main);
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            transition: all 0.3s ease;
            background-color: transparent;
            font-weight: bold;
        }

            .navbar-toggler:hover {
                background-color: var(--color-secondary-main);
                color: var(--color-primary-dark);
                box-shadow: 0 0 10px rgba(232, 128, 49, 0.5);
            }

        /* Menú Offcanvas (Tree-list Burger Menu) */
        .offcanvas-header {
            background-color: var(--color-primary-dark);
            border-bottom: 3px solid var(--color-secondary-main);
        }

        .tree-list-menu {
            padding: 0;
            margin: 0;
            list-style: none;
        }

            .tree-list-menu .menu-item {
                display: block;
                padding: 0.75rem 1rem;
                color: var(--color-primary-dark);
                font-weight: 700;
                text-decoration: none;
                border-radius: 8px;
                margin-bottom: 0.25rem;
                transition: all 0.2s ease;
                border-left: 4px solid transparent;
            }

                .tree-list-menu .menu-item:hover,
                .tree-list-menu .menu-item[aria-expanded="true"] {
                    background-color: rgba(232, 128, 49, 0.15); /* Fondo naranja super clarito */
                    color: var(--color-primary-main);
                    border-left: 4px solid var(--color-secondary-main);
                }

        /* Submenús */
        .tree-submenu {
            list-style: none;
            padding-left: 1.5rem;
            margin-top: 0.25rem;
            margin-bottom: 0.5rem;
            border-left: 2px solid var(--color-secondary-light);
            margin-left: 1rem;
        }

            .tree-submenu .submenu-item {
                display: block;
                padding: 0.5rem 1rem;
                color: #555;
                text-decoration: none;
                font-size: 0.95rem;
                font-weight: 600;
                border-radius: 6px;
                transition: all 0.2s;
            }

                .tree-submenu .submenu-item:hover {
                    background-color: var(--color-primary-main);
                    color: var(--color-background-light);
                    transform: translateX(5px);
                }

        .menu-icon {
            margin-right: 10px;
            font-size: 1.2rem;
        }

        /* Footer */
        .custom-footer {
            background-color: var(--color-primary-dark);
            border-top: 3px solid var(--color-primary-main);
            color: var(--color-secondary-light);
        }

            .custom-footer a {
                color: var(--color-background-light);
                text-decoration: none;
                font-weight: bold;
            }

                .custom-footer a:hover {
                    color: var(--color-secondary-main);
                }

        /* SweetAlert Custom Styles (Mismas imágenes y GIF solicitadas) */
        .mi-alerta {
            background: #403b49 url('/sweetalertFondo.png') center center / cover no-repeat !important;
            border-radius: 12px;
            border: 2px solid var(--color-primary-main) !important;
        }

            .mi-alerta .swal2-title {
                color: #fff !important;
            }

        .mi-backdrop {
            background: rgba(35, 31, 42, 0.85) !important; /* Oscuro */
            position: fixed;
        }

            .mi-backdrop::after {
                content: "";
                position: absolute;
                bottom: 10px;
                left: 50%;
                transform: translateX(-50%);
                width: 90px;
                height: 90px;
                background-image: url('/sweetalertBg.gif');
                background-size: contain;
                background-position: center;
                background-repeat: no-repeat;
                pointer-events: none;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar custom-navbar mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <!-- Logo con borde Naranja EVA-02 -->
                    <img src="/logo_occode.png" alt="Logo" width="50" height="50" class="d-inline-block align-text-top me-2 rounded-circle mx-3 shadow" style="border: 2px solid var(--color-secondary-main);">
                    OCCODE - CONTABILIDAD
                </a>

                <!-- Botón Hamburguesa -->
                <button class="navbar-toggler shadow-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasMenu" aria-controls="offcanvasMenu">
                    <span class="fs-5">☰ Menú</span>
                </button>
            </div>
        </nav>
    </header>

    <!-- Menú Lateral (Offcanvas Tree-list) -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasMenu" aria-labelledby="offcanvasMenuLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title fw-bold" id="offcanvasMenuLabel" style="color: var(--color-secondary-main);">
                Módulos del Sistema
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="tree-list-menu">

                <li>
                    <a asp-controller="Home" asp-action="Index" class="menu-item">
                        <span class="menu-icon">🏠</span> Inicio
                    </a>
                </li>

                <!-- Rama: Contabilidad SAESCON -->
                <li>
                    <a href="#menuContabilidad" class="menu-item d-flex justify-content-between align-items-center" data-bs-toggle="collapse" role="button" aria-expanded="false">
                        <span><span class="menu-icon">📊</span> Contabilidad</span>
                        <span>▼</span>
                    </a>
                    <div class="collapse" id="menuContabilidad">
                        <ul class="tree-submenu">
                            <li><a asp-controller="Contabilidad" asp-action="Nomenclatura" class="submenu-item">Nomenclatura Contable</a></li>
                            <li><a asp-controller="Contabilidad" asp-action="Asientos" class="submenu-item">Asientos Contables</a></li>
                            <li><a asp-controller="Contabilidad" asp-action="Mayorizacion" class="submenu-item">Mayorización</a></li>
                            <li><a asp-controller="Contabilidad" asp-action="Cierre" class="submenu-item">Cierre Anual</a></li>
                        </ul>
                    </div>
                </li>

                <!-- Rama: Seguridad (SQL Server) -->
                <li>
                    <a href="#menuSeguridad" class="menu-item d-flex justify-content-between align-items-center" data-bs-toggle="collapse" role="button" aria-expanded="false">
                        <span><span class="menu-icon">🛡️</span> Seguridad</span>
                        <span>▼</span>
                    </a>
                    <div class="collapse" id="menuSeguridad">
                        <ul class="tree-submenu">
                            <li><a asp-controller="Seguridad" asp-action="Usuarios" class="submenu-item">Usuarios</a></li>
                            <li><a asp-controller="Seguridad" asp-action="Roles" class="submenu-item">Roles y Perfiles</a></li>
                            <li><a asp-controller="Seguridad" asp-action="Permisos" class="submenu-item">Permisos (Grants)</a></li>
                        </ul>
                    </div>
                </li>

                <li><hr class="dropdown-divider my-3"></li>

                <li>
                    <a asp-controller="Home" asp-action="Privacy" class="menu-item text-muted">
                        <span class="menu-icon">🔒</span> Privacidad y Políticas
                    </a>
                </li>

            </ul>
        </div>
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer custom-footer text-center py-3 mt-auto">
        <div class="container">
            &copy; 2026 - OCCODE_CON PROYECTO BD1 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>